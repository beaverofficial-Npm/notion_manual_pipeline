# ─────────────────────────────────────────────────────────────
# PPT → Notion 매뉴얼 변환 파이프라인 · 환경변수 예시
# 이 파일을 `.env` 로 복사한 뒤 값을 채웁니다:  cp .env.example .env
# 가장 빠른 방법 = Railway 프로젝트 Variables 값을 그대로 복사.
# ⚠️ 실제 값(비밀)은 절대 깃/문서/메신저에 넣지 않습니다. .env 는 gitignore 됨.
# ─────────────────────────────────────────────────────────────

# ── Supabase (Postgres + 메타데이터) ──────────────────────────
# 값: Supabase 대시보드 → 프로젝트 → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=            # 브라우저용 공개 anon 키
SUPABASE_SERVICE_ROLE_KEY=               # 서버·워커 전용 비밀 (절대 노출 금지)

# ── Notion 발행 ───────────────────────────────────────────────
# 값: Notion 내부 통합 "Notion_manual" 시크릿 + 대상 DB/데이터소스 ID
NOTION_TOKEN=                            # ntn_... (비밀)
NOTION_MANUAL_DATABASE_ID=
NOTION_MANUAL_DATA_SOURCE_ID=
# (선택) 발행 이미지 최대 폭 px. 기본 540 (≈일반 페이지 75%)
NOTION_IMAGE_MAX_WIDTH=540

# ── R2 / S3 오브젝트 스토리지 (원본 PPT + 변환 산출물) ────────
# ★ 필수. 없으면 업로드·변환이 동작하지 않습니다.
# 값: Cloudflare R2 대시보드 → 버킷 + R2 API 토큰(S3 호환).
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=manual-source
R2_REGION=auto
R2_ACCESS_KEY_ID=                        # R2 API 토큰 Access Key (비밀)
R2_SECRET_ACCESS_KEY=                    # R2 API 토큰 Secret (비밀)

# ── 변환 워커 튜닝 (선택 — 기본값으로 동작) ───────────────────
# 로컬 바이너리 경로 오버라이드(미설정 시 PATH 에서 탐색)
SOFFICE_BIN=soffice
PDFTOPPM_BIN=pdftoppm
PDFINFO_BIN=pdfinfo
# 렌더 품질
RENDER_DPI=300
RENDER_LOSSLESS=1
# 워커 폴링 주기(ms). 버전 도장(WORKER_VERSION)은 미설정 시 git SHA 사용
WORKER_POLL_MS=5000
# WORKER_VERSION=
# INLINE_WORKER=1  # 웹 프로세스 안에서 변환까지 실행(로컬 단독 테스트용, 운영 비권장)
